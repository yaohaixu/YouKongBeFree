# Server
PORT=8080

# Initial admin account. The real values should live in `.env` or the CloudBase console, not in Git.
YKADMIN_NICKNAME=有空管理员
YKADMIN_PHONE=请替换为管理员手机号

# Storage driver: json for local development, cloudbase for Tencent CloudBase.
STORE_DRIVER=json
CLOUDBASE_ENV_ID=youkong-d5gh4x0ayc29a2187

# Security controls.
# Comma-separated origins that may call the API with credentials.
CORS_ORIGINS=https://youkong-d5gh4x0ayc29a2187-1441855189.tcloudbaseapp.com
# Public static site origin used when API creates browser-openable links.
PUBLIC_SITE_ORIGIN=https://youkong-d5gh4x0ayc29a2187-1441855189.tcloudbaseapp.com

# WeChat Mini Program identity binding. AppSecret must only be configured server-side.
WECHAT_MP_APPID=wx5020d6431cfac041
WECHAT_MP_SECRET=请在 CloudBase 环境变量中配置小程序 AppSecret
# Optional comma-separated subscription message template IDs for activity reminders.
WECHAT_MP_ACTIVITY_REMINDER_TEMPLATE_IDS=

# Anonymous identity / Community OS.
# Use a long random value in production; changing it will create new anonymous identities.
IDENTITY_HASH_SALT=请替换为长随机字符串
# Optional independent signing key for the server-set anonymous identity cookie.
ANONYMOUS_ID_SECRET=请替换为长随机字符串

# Cloudflare Turnstile. Disabled by default; local development can bypass it.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS_LOCAL=true

# AI Analysis Engine config encryption. Use a stable long random value in production.
AI_CONFIG_ENCRYPTION_KEY=请替换为长随机字符串
# One-release migration key only. Leave empty for new environments.
AI_CONFIG_ENCRYPTION_KEY_PREVIOUS=

# Production secret guard.
# In CloudBase production this defaults to required unless explicitly disabled.
REQUIRE_PRODUCTION_SECRETS=true

# Session lifetime in days. The server clamps this value to 1-30 days.
SESSION_SECRET=请替换为长随机字符串
SESSION_MAX_AGE_DAYS=14

# Anonymous activity management token lifetime.
MANAGE_TOKEN_MAX_AGE_DAYS=180

# Upload decompression-bomb guard.
MAX_IMAGE_PIXELS=18000000
MAX_IMAGE_SIDE=8000

# AI Provider SSRF guard. Keep false in CloudBase production.
ALLOW_PRIVATE_AI_BASE_URL=false

# Activity auto-ending.
# Activities are marked ended after their activity date passes in Asia/Shanghai.
ACTIVITY_AUTO_END_INTERVAL_MS=900000
ACTIVITY_AUTO_END_MIN_SWEEP_MS=60000
ACTIVITY_EDIT_LOCK_TTL_MINUTES=360
DISABLE_ACTIVITY_AUTO_END=false

# API timing diagnostics.
# Slow API requests and 5xx responses are logged to server / CloudBase function logs.
API_TIMING_LOGS=true
API_SLOW_LOG_MS=1200

# Optional Redis speed layer. Disabled by default; Redis is only a cache / counter layer, not primary storage.
CACHE_DRIVER=noop
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=yk:prod:v1
REDIS_CONNECT_TIMEOUT_MS=800
REDIS_CACHE_TIMEOUT_MS=90
PUBLIC_CONFIG_CACHE_TTL_SECONDS=600
PUBLIC_BOOTSTRAP_CACHE_TTL_SECONDS=90
PUBLIC_ACTIVITY_LIST_CACHE_TTL_SECONDS=45
PUBLIC_ACTIVITY_DETAIL_CACHE_TTL_SECONDS=120
PUBLIC_CACHE_STALE_SECONDS=30

# Optional local JSON database path for smoke tests.
YK_DB_FILE=
