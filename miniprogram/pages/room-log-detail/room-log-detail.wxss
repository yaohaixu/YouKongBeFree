.detail-page {
  padding-bottom: 88rpx;
}

.status-card {
  overflow: hidden;
  border-radius: 28rpx;
  padding: 30rpx;
  color: #fffefa;
  box-shadow: 0 18rpx 42rpx rgba(16, 23, 20, 0.14);
}

.status-card.tone-open { background: #1f6537; }
.status-card.tone-upcoming { background: #956a1d; }
.status-card.tone-closed { background: #9f392b; }
.status-card.tone-empty { background: #101714; }

.status-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.status-label {
  color: rgba(255, 254, 250, 0.72);
  font-size: 23rpx;
  font-weight: 780;
}

.status-title {
  margin-top: 10rpx;
  color: #fffefa;
  font-size: 42rpx;
  font-weight: 880;
  line-height: 1.18;
}

.status-text {
  margin-top: 14rpx;
  color: rgba(255, 254, 250, 0.74);
  font-size: 25rpx;
  line-height: 1.55;
}

.status-icon {
  flex: 0 0 auto;
}

.status-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 26rpx;
}

.status-actions .button {
  width: 100%;
  background: #fffefa;
  color: #101714;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.12);
}

.status-actions .button.secondary {
  border: 1rpx solid rgba(255, 254, 250, 0.18);
  background: rgba(255, 254, 250, 0.1);
  color: #fffefa;
  box-shadow: none;
}

.status-actions .button.danger {
  border: 1rpx solid rgba(255, 254, 250, 0.18);
  background: #fff0eb;
  color: #8f2e24;
  box-shadow: none;
}

.content-card,
.note-card,
.review-hint {
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 24rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
}

.rich-content {
  display: block;
  color: #24342a;
  font-size: 28rpx;
  line-height: 1.78;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.empty-copy {
  color: #69746d;
  font-size: 26rpx;
  line-height: 1.6;
}

.ai-review-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
  padding: 14rpx 16rpx;
  background: #fff6e6;
  color: #765211;
  font-size: 23rpx;
  font-weight: 720;
  line-height: 1.5;
}

.ai-review-line.note-review {
  margin-bottom: 14rpx;
}

.ai-review-line text {
  flex: 1;
  min-width: 0;
}

.section-head-line {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 40rpx 0 18rpx;
}

.inline-title {
  margin: 0;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #69746d;
  font-size: 24rpx;
  line-height: 1.5;
}

.small-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-height: 68rpx;
  border-radius: 999rpx;
  padding: 0 18rpx;
  background: #a24d2b;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 780;
  white-space: nowrap;
}

.empty-note-action {
  margin-top: 18rpx;
}

.empty-note-action .button {
  width: 100%;
}

.note-card {
  margin-bottom: 18rpx;
}

.author-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.author-avatar {
  overflow: hidden;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #e9eee8;
  color: #101714;
  font-size: 28rpx;
  font-weight: 850;
}

.author-avatar image,
.author-avatar view {
  width: 100%;
  height: 100%;
}

.author-avatar view {
  display: flex;
  align-items: center;
  justify-content: center;
}

.author-name {
  color: #101714;
  font-size: 28rpx;
  font-weight: 820;
}

.author-time {
  margin-top: 4rpx;
  color: #7a837d;
  font-size: 23rpx;
}

.note-content {
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(16, 23, 20, 0.07);
}

.review-hint {
  margin-top: 22rpx;
  background: #fff7f2;
}

.review-title {
  margin-bottom: 12rpx;
  color: #9f392b;
  font-size: 26rpx;
  font-weight: 820;
}
