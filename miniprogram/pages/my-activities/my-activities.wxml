<view class="page">
  <view class="hero compact">
    <view class="eyebrow">我的活动</view>
    <view class="title">看这个身份发起过什么。</view>
    <view class="body">这里会同步当前身份发起的草稿、分析中和已发布活动。</view>
    <view class="button-row">
      <view class="button" bindtap="goEditor">发起活动</view>
    </view>
  </view>

  <view class="filter-tabs">
    <view class="filter {{status === '' ? 'active' : ''}}" data-status="" bindtap="switchStatus">全部</view>
    <view class="filter {{status === 'draft' ? 'active' : ''}}" data-status="draft" bindtap="switchStatus">草稿</view>
    <view class="filter {{status === 'reviewing' ? 'active' : ''}}" data-status="reviewing" bindtap="switchStatus">复核</view>
    <view class="filter {{status === 'published_group' ? 'active' : ''}}" data-status="published_group" bindtap="switchStatus">已发布</view>
  </view>

  <view wx:if="{{loading}}" class="panel muted">正在读取我的活动...</view>
  <view wx:elif="{{error}}" class="panel muted">{{error}}</view>
  <block wx:elif="{{activities.length}}">
    <view class="list">
      <view class="owner-card" wx:for="{{activities}}" wx:key="id">
        <view class="owner-head">
          <view class="owner-meta">
            <text>{{item.displaySource || item.moduleName || "有空客厅"}}</text>
            <text wx:if="{{item.displaySeries}}">{{item.displaySeries}}</text>
          </view>
          <view class="status-pill">{{item.statusLabel || "活动"}}</view>
        </view>
        <view class="owner-title">{{item.title || "未命名活动"}}</view>
        <view class="owner-line">{{item.displayTime || "时间待定"}}</view>
        <view class="owner-line">{{item.location || "地点待定"}}</view>
        <view wx:if="{{item.displayFormation}}" class="formation-note">{{item.displayFormation}}</view>
        <view class="stats-row">
          <view class="stat-item">
            <view class="stat-value">{{item.registrationCount || 0}}</view>
            <view class="stat-label">报名</view>
          </view>
          <view class="stat-item">
            <view class="stat-value">{{item.interestCount || 0}}</view>
            <view class="stat-label">感兴趣</view>
          </view>
          <view class="stat-item">
            <view class="stat-value">{{item.feedbackCount || 0}}</view>
            <view class="stat-label">活动感受</view>
          </view>
        </view>
        <view wx:if="{{item.permissions.canEdit || item.permissions.canWithdraw || item.permissions.canCancel || item.permissions.canEnd || item.permissions.canManageCoInitiators}}" class="owner-actions">
          <view wx:if="{{item.permissions.canEdit}}" class="mini-action" data-id="{{item.id}}" catchtap="goEditor">编辑</view>
          <view class="mini-action" data-id="{{item.id}}" catchtap="goRegistrations">报名表</view>
          <view class="mini-action" data-id="{{item.id}}" catchtap="goActivityFeedbacks">活动感受</view>
          <view wx:if="{{item.permissions.canWithdraw}}" class="mini-action wide" data-id="{{item.id}}" data-title="{{item.title}}" data-action="withdraw" catchtap="runActivityAction">撤回为草稿</view>
          <view wx:if="{{item.permissions.canEnd}}" class="mini-action" data-id="{{item.id}}" data-title="{{item.title}}" data-action="end" catchtap="runActivityAction">结束活动</view>
          <view wx:if="{{item.permissions.canCancel}}" class="mini-action danger" data-id="{{item.id}}" data-title="{{item.title}}" data-action="cancel" catchtap="runActivityAction">取消活动</view>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="loading-more">继续读取中...</view>
    <view wx:elif="{{!hasMore}}" class="loading-more">已经到底了</view>
  </block>
  <empty-state wx:else title="还没有发起过活动" text="可以先保存草稿，也可以直接提交进入安全分析。" />
</view>
