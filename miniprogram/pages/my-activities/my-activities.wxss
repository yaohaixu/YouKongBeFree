.compact {
  padding-bottom: 16rpx;
}

.filter-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 999rpx;
  background: #fffefa;
}

.filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  border-radius: 999rpx;
  color: #69746d;
  font-size: 24rpx;
  font-weight: 760;
}

.filter.active {
  background: #101714;
  color: #fffefa;
}

.loading-more {
  padding: 20rpx 0;
  color: #69746d;
  text-align: center;
  font-size: 25rpx;
}
.activity-shell {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 254, 250, 0.72);
}

.mini-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 999rpx;
  background: #fffefa;
  color: #101714;
  font-size: 26rpx;
  font-weight: 780;
}

.mini-action.danger {
  border-color: rgba(159, 57, 43, 0.22);
  color: #9f392b;
}
