.compact {
  padding-bottom: 16rpx;
}

.filter-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 999rpx;
  background: #fcfcfa;
  box-shadow: 0 8rpx 20rpx rgba(20, 28, 23, 0.04);
}

.filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  border-radius: 999rpx;
  color: #69746d;
  font-size: 24rpx;
  font-weight: 760;
  transition: transform 150ms ease-out, background-color 150ms ease-out;
}

.filter:active {
  transform: scale(0.98);
}

.filter.active {
  background: #101714;
  color: #ffffff;
}

.loading-more {
  padding: 20rpx 0;
  color: #69746d;
  text-align: center;
  font-size: 25rpx;
}

.owner-card {
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 24rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
  transition: transform 150ms ease-out, box-shadow 150ms ease-out;
}

.owner-card:active {
  transform: scale(0.992);
  box-shadow: 0 7rpx 18rpx rgba(20, 28, 23, 0.04);
}

.owner-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.owner-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
}

.owner-meta text,
.status-pill {
  border: 1rpx solid rgba(16, 23, 20, 0.06);
  border-radius: 999rpx;
  padding: 8rpx 15rpx;
  background: #eef2ec;
  color: #34443b;
  font-size: 23rpx;
  font-weight: 760;
  line-height: 1.25;
}

.status-pill {
  flex: 0 0 auto;
  background: #101714;
  color: #ffffff;
}

.owner-title {
  margin-top: 18rpx;
  color: #101714;
  font-size: 35rpx;
  font-weight: 860;
  line-height: 1.3;
}

.owner-line {
  margin-top: 9rpx;
  color: #536158;
  font-size: 25rpx;
  line-height: 1.45;
}

.formation-note {
  margin-top: 14rpx;
  border-radius: 18rpx;
  padding: 12rpx 16rpx;
  background: #f3f5f0;
  color: #4d5b53;
  font-size: 23rpx;
  line-height: 1.5;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
}

.stat-item {
  border-radius: 18rpx;
  padding: 16rpx 10rpx;
  background: #f4f6f2;
  text-align: center;
}

.stat-value {
  color: #101714;
  font-size: 31rpx;
  font-weight: 860;
  line-height: 1.15;
}

.stat-label {
  margin-top: 4rpx;
  color: #69746d;
  font-size: 22rpx;
  font-weight: 720;
}

.owner-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.mini-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 176rpx;
  min-height: 76rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 999rpx;
  padding: 0 20rpx;
  background: #fcfcfa;
  color: #101714;
  font-size: 26rpx;
  font-weight: 780;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  transition: transform 150ms ease-out, opacity 150ms ease-out;
}

.mini-action:active {
  transform: scale(0.985);
  opacity: 0.88;
}

.mini-action.danger {
  border-color: rgba(159, 57, 43, 0.22);
  background: #fff7f2;
  color: #9f392b;
}

.mini-action.wide {
  flex-basis: 240rpx;
}
