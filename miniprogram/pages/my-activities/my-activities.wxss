.compact {
  padding-bottom: 16rpx;
}

.filter-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 999rpx;
  background: #fcfcfa;
  box-shadow: 0 8rpx 20rpx rgba(20, 28, 23, 0.04);
}

.filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  border-radius: 999rpx;
  color: #69746d;
  font-size: 24rpx;
  font-weight: 760;
  transition: transform 150ms ease-out, background-color 150ms ease-out;
}

.filter:active {
  transform: scale(0.98);
}

.filter.active {
  background: #101714;
  color: #ffffff;
}

.loading-more {
  padding: 20rpx 0;
  color: #69746d;
  text-align: center;
  font-size: 25rpx;
}
.activity-shell {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  background: rgba(252, 252, 250, 0.86);
  box-shadow: 0 8rpx 20rpx rgba(20, 28, 23, 0.035);
}

.mini-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 999rpx;
  background: #fcfcfa;
  color: #101714;
  font-size: 26rpx;
  font-weight: 780;
  transition: transform 150ms ease-out, opacity 150ms ease-out;
}

.mini-action:active {
  transform: scale(0.985);
  opacity: 0.88;
}

.mini-action.danger {
  border-color: rgba(159, 57, 43, 0.22);
  background: #fff7f2;
  color: #9f392b;
}
