<view class="page">
  <view class="hero compact">
    <view class="eyebrow">我的报名</view>
    <view class="title">报名记录会留在这里。</view>
    <view class="body">同步设备后，不同设备上的报名记录会合并展示。</view>
  </view>

  <view class="filter-tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="filter {{view === item.key ? 'active' : ''}}" data-view="{{item.key}}" bindtap="switchView">{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="panel muted">正在读取报名记录...</view>
  <view wx:elif="{{error}}" class="panel muted">{{error}}</view>
  <block wx:elif="{{registrations.length}}">
    <view class="record-card" wx:for="{{registrations}}" wx:key="id" data-id="{{item.activity.id}}" data-registration-id="{{item.id}}" bindtap="openActivity">
      <view class="tag-row">
        <text class="tag">{{item.activity.statusLabel || "活动"}}</text>
        <text class="tag soft">报名昵称：{{item.nickname}}</text>
        <text wx:if="{{view === 'past' && item.activity.hasMyFeedback}}" class="tag quiet">已写感受</text>
      </view>
      <view class="record-title">{{item.activity.title || "未命名活动"}}</view>
      <view class="record-text">{{item.activity.location || "地点待定"}} · {{item.activity.displayTime}}</view>
      <view class="record-foot">报名时间：{{item.displayCreatedAt || "刚刚"}}</view>
      <view wx:if="{{view === 'past' && item.activity.canWriteFeedback && !item.activity.hasMyFeedback}}" class="record-actions">
        <view class="mini-action feeling" data-id="{{item.activity.id}}" catchtap="goFeedback">写下活动感受</view>
      </view>
      <view wx:elif="{{item.canCancel}}" class="record-actions">
        <view class="mini-action danger" data-item="{{item}}" catchtap="cancelRegistration">取消报名</view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="loading-more">继续读取中...</view>
    <view wx:elif="{{!hasMore}}" class="loading-more">已经到底了</view>
  </block>
  <empty-state wx:else title="{{view === 'past' ? '还没有已参加活动' : '还没有待参加活动'}}" text="{{view === 'past' ? '活动结束后，会在这里回看报名历史并写下活动感受。' : '报名成功、活动详情和取消后的状态，都从这里回看。'}}" />
</view>
