.compact {
  padding-bottom: 18rpx;
}

.record-card {
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 26rpx;
  padding: 24rpx;
  background: #fffefa;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #101714;
  color: #fffefa;
  font-size: 23rpx;
  font-weight: 760;
}

.tag.soft {
  background: #e8eee6;
  color: #314036;
}

.record-title {
  margin-top: 18rpx;
  color: #101714;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.3;
}

.record-text,
.record-foot {
  margin-top: 10rpx;
  color: #5e6962;
  font-size: 26rpx;
  line-height: 1.55;
}

.record-foot {
  color: #7c847e;
  font-size: 24rpx;
}

.record-actions {
  margin-top: 18rpx;
}

.mini-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 999rpx;
  background: #fffefa;
  color: #101714;
  font-size: 26rpx;
  font-weight: 780;
}

.mini-action.danger {
  border-color: rgba(159, 57, 43, 0.22);
  color: #9f392b;
}

.loading-more {
  padding: 20rpx 0;
  color: #69746d;
  text-align: center;
  font-size: 25rpx;
}
