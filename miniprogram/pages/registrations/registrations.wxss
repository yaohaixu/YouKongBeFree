.compact {
  padding-bottom: 18rpx;
}

.filter-tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 999rpx;
  background: #fcfcfa;
  box-shadow: 0 8rpx 20rpx rgba(20, 28, 23, 0.04);
}

.filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  border-radius: 999rpx;
  color: #69746d;
  font-size: 24rpx;
  font-weight: 760;
  transition: transform 150ms ease-out, background-color 150ms ease-out;
}

.filter:active {
  transform: scale(0.98);
}

.filter.active {
  background: #101714;
  color: #ffffff;
}

.record-card {
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 24rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
  transition: transform 150ms ease-out, box-shadow 150ms ease-out;
}

.record-card:active {
  transform: scale(0.988);
  box-shadow: 0 6rpx 16rpx rgba(20, 28, 23, 0.04);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  border: 1rpx solid rgba(16, 23, 20, 0.06);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #101714;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 760;
}

.tag.soft {
  background: #e9eee8;
  color: #314036;
}

.tag.quiet {
  background: #f1ece4;
  color: #806553;
}

.record-title {
  margin-top: 18rpx;
  color: #101714;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.3;
}

.record-text,
.record-foot {
  margin-top: 10rpx;
  color: #5e6962;
  font-size: 26rpx;
  line-height: 1.55;
}

.record-foot {
  color: #7c847e;
  font-size: 24rpx;
}

.record-actions {
  margin-top: 18rpx;
}

.mini-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 999rpx;
  background: #fcfcfa;
  color: #101714;
  font-size: 26rpx;
  font-weight: 780;
}

.mini-action.danger {
  border-color: rgba(159, 57, 43, 0.22);
  background: #fff7f2;
  color: #9f392b;
}

.mini-action.feeling {
  border-color: rgba(157, 73, 42, 0.18);
  background: #a24d2b;
  color: #ffffff;
}

.loading-more {
  padding: 20rpx 0;
  color: #69746d;
  text-align: center;
  font-size: 25rpx;
}
