.compact {
  padding-bottom: 16rpx;
}

.invite-card {
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(16, 23, 20, 0.08);
}

.info-row text {
  color: #69746d;
  font-size: 25rpx;
}

.info-row strong {
  flex: 1;
  color: #101714;
  text-align: right;
  font-size: 27rpx;
  font-weight: 820;
}

.hint {
  margin-top: 20rpx;
  color: #69746d;
  font-size: 25rpx;
  line-height: 1.6;
}
