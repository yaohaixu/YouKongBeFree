<view class="page">
  <view class="hero compact">
    <view class="profile-hero-row">
      <view class="profile-avatar" data-url="/pages/profile-editor/profile-editor" bindtap="openEntry">
        <image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill" />
        <view wx:else>{{avatarInitial}}</view>
      </view>
      <view class="profile-copy">
        <view class="eyebrow">我的</view>
        <view class="title">{{profile.displayName || "有空朋友"}}</view>
        <view class="body">{{profile.bio || "点击头像，可以编辑头像、昵称和个人简介。"}}</view>
        <view class="profile-edit-hint">点头像编辑公开资料</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="panel muted">正在读取我的信息...</view>
  <view wx:elif="{{error}}" class="panel muted">{{error}}</view>
  <view wx:else>
    <view class="section-title first-section">最近活动</view>
    <block wx:if="{{recentEvents.length}}">
      <view class="timeline-card" wx:for="{{recentEvents}}" wx:key="id" data-url="{{item.url}}" bindtap="openRecent">
        <yk-icon name="{{item.icon}}" size="{{66}}" frame="entry" tone="{{item.tone}}" custom-class="timeline-icon" />
        <view class="timeline-content">
          <view class="timeline-top">
            <view class="timeline-title">{{item.title}}</view>
            <view class="timeline-status">{{item.statusLabel}}</view>
          </view>
          <view class="timeline-text">{{item.subtitle || "和客厅有关的一件事"}}</view>
          <view class="timeline-time">{{item.displayTime}}</view>
        </view>
      </view>
    </block>
    <view wx:else class="panel empty-recent">
      <view class="empty-title">最近还没有和客厅约好的事</view>
      <view class="empty-text">可以先看看活动，或者预约一次开门。</view>
      <view class="button-row">
        <view class="button secondary" data-url="/pages/activities/activities" bindtap="openEntry"><yk-icon name="activity" size="{{28}}" custom-class="button-icon" />看看活动</view>
        <view class="button secondary" data-url="/pages/room-log-list/room-log-list" bindtap="openEntry"><yk-icon name="door" size="{{28}}" custom-class="button-icon" />有空开门</view>
      </view>
    </view>

    <view class="entry-list">
      <view class="entry-card primary-entry" data-url="/pages/activity-editor/activity-editor" bindtap="openEntry">
        <yk-icon name="compose" size="{{76}}" frame="entry" tone="primary" custom-class="entry-icon" />
        <view class="entry-content">
          <view class="entry-title">发起活动</view>
          <view class="entry-text">写下一个新的活动想法</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>
      <view class="entry-card" data-url="/pages/room-log-list/room-log-list" bindtap="openEntry">
        <yk-icon name="door" size="{{76}}" frame="entry" tone="rose" custom-class="entry-icon" />
        <view class="entry-content">
          <view class="entry-title">有空开门</view>
          <view class="entry-text">预约开门、确认关门和查看我的值班记录</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>
      <view class="entry-card" data-url="/pages/my-feedbacks/my-feedbacks" bindtap="openEntry">
        <yk-icon name="feedback" size="{{76}}" frame="entry" tone="blue" custom-class="entry-icon" />
        <view class="entry-content">
          <view class="entry-title">我的反馈</view>
          <view class="entry-text">回看写过的匿名活动反馈</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>
    </view>

    <view class="section-title">常用入口</view>
    <view class="bottom-grid">
      <view class="bottom-entry" wx:for="{{bottomEntries}}" wx:key="title" data-url="{{item.url}}" bindtap="openEntry">
        <yk-icon name="{{item.icon}}" size="{{62}}" frame="entry" tone="{{item.tone}}" custom-class="bottom-icon" />
        <view class="bottom-title">{{item.title}}</view>
        <view class="bottom-text">{{item.text}}</view>
        <view class="bottom-meta">{{item.meta}}</view>
      </view>
    </view>
  </view>
</view>
