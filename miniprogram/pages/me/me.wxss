.compact {
  padding-bottom: 20rpx;
}

.profile-hero-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  flex: 0 0 auto;
  overflow: hidden;
  width: 132rpx;
  height: 132rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 40rpx;
  background: linear-gradient(145deg, #eef5ef, #dfe8dc);
  box-shadow: 0 12rpx 28rpx rgba(20, 28, 23, 0.08);
  transition: transform 150ms ease-out;
}

.profile-avatar:active {
  transform: scale(0.975);
}

.profile-avatar image,
.profile-avatar view {
  width: 100%;
  height: 100%;
}

.profile-avatar view {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #101714;
  font-size: 46rpx;
  font-weight: 880;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-edit-hint {
  display: inline-flex;
  margin-top: 14rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
  background: #f2f5ef;
  color: #30433a;
  font-size: 22rpx;
  font-weight: 760;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat {
  min-height: 150rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 22rpx 14rpx;
  background: #fcfcfa;
  color: #69746d;
  text-align: center;
  font-size: 23rpx;
  box-shadow: 0 8rpx 20rpx rgba(20, 28, 23, 0.04);
  animation: cardRise 360ms cubic-bezier(0.2, 0, 0, 1);
}

.num {
  display: block;
  margin-bottom: 8rpx;
  color: #101714;
  font-size: 42rpx;
  font-weight: 880;
}

.registration {
  margin-bottom: 16rpx;
}

.registration-title {
  margin-bottom: 8rpx;
  color: #101714;
  font-size: 30rpx;
  font-weight: 820;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 28rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 130rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 22rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
  transition: transform 150ms ease-out, box-shadow 150ms ease-out, background-color 150ms ease-out;
  animation: cardRise 360ms cubic-bezier(0.2, 0, 0, 1);
}

.entry-card:active {
  transform: scale(0.985);
  box-shadow: 0 6rpx 16rpx rgba(20, 28, 23, 0.04);
}

.primary-entry {
  border-color: rgba(16, 23, 20, 0.22);
  background: #101714;
  color: #fffefa;
  box-shadow: 0 14rpx 32rpx rgba(16, 23, 20, 0.12);
}

.primary-entry .entry-icon {
  background: #fffefa;
  color: #101714;
}

.primary-entry .entry-title {
  color: #fffefa;
}

.primary-entry .entry-text,
.primary-entry .entry-arrow {
  color: rgba(255, 254, 250, 0.72);
}

.entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #eef5ef, #dfe8dc);
  color: #101714;
  font-size: 28rpx;
  font-weight: 850;
}

.entry-content {
  flex: 1;
  min-width: 0;
}

.entry-title {
  color: #101714;
  font-size: 31rpx;
  font-weight: 850;
}

.entry-text {
  margin-top: 6rpx;
  color: #69746d;
  font-size: 25rpx;
  line-height: 1.45;
}

.entry-arrow {
  color: #8a928c;
  font-size: 42rpx;
  line-height: 1;
}

@keyframes cardRise {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
