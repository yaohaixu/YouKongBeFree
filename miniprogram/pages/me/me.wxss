.compact {
  padding-bottom: 20rpx;
}

.profile-hero-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  flex: 0 0 auto;
  overflow: hidden;
  width: 132rpx;
  height: 132rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 40rpx;
  background: linear-gradient(145deg, #eef5ef, #dfe8dc);
  box-shadow: 0 12rpx 28rpx rgba(20, 28, 23, 0.08);
  transition: transform 150ms ease-out;
}

.profile-avatar:active {
  transform: scale(0.975);
}

.profile-avatar image,
.profile-avatar view {
  width: 100%;
  height: 100%;
}

.profile-avatar view {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #101714;
  font-size: 46rpx;
  font-weight: 880;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-edit-hint {
  display: inline-flex;
  margin-top: 14rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
  background: #f2f5ef;
  color: #30433a;
  font-size: 22rpx;
  font-weight: 760;
}

.first-section {
  margin-top: 10rpx;
}

.timeline-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 20rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 24rpx rgba(20, 28, 23, 0.04);
  transition: transform 150ms ease-out, box-shadow 150ms ease-out;
  animation: cardRise 360ms cubic-bezier(0.2, 0, 0, 1);
}

.timeline-card:active {
  transform: scale(0.99);
  box-shadow: 0 6rpx 16rpx rgba(20, 28, 23, 0.04);
}

.timeline-icon {
  flex: 0 0 auto;
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
}

.timeline-content {
  flex: 1;
  min-width: 0;
}

.timeline-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.timeline-title {
  min-width: 0;
  color: #101714;
  font-size: 29rpx;
  font-weight: 840;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-status {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
  background: #e9eee8;
  color: #314036;
  font-size: 21rpx;
  font-weight: 760;
}

.timeline-text,
.timeline-time {
  margin-top: 7rpx;
  color: #69746d;
  font-size: 24rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-time {
  color: #8a928c;
  font-size: 22rpx;
}

.empty-recent {
  margin-bottom: 16rpx;
}

.empty-title {
  color: #101714;
  font-size: 30rpx;
  font-weight: 830;
}

.empty-text {
  margin-top: 8rpx;
  color: #69746d;
  font-size: 25rpx;
  line-height: 1.55;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 28rpx;
}

.bottom-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.bottom-entry {
  min-height: 210rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 18rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 24rpx rgba(20, 28, 23, 0.04);
  transition: transform 150ms ease-out, box-shadow 150ms ease-out;
}

.bottom-entry:active {
  transform: scale(0.985);
  box-shadow: 0 6rpx 16rpx rgba(20, 28, 23, 0.04);
}

.bottom-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
}

.bottom-title {
  margin-top: 14rpx;
  color: #101714;
  font-size: 27rpx;
  font-weight: 840;
  line-height: 1.25;
}

.bottom-text {
  margin-top: 8rpx;
  color: #69746d;
  font-size: 22rpx;
  line-height: 1.4;
}

.bottom-meta {
  margin-top: 12rpx;
  color: #31624b;
  font-size: 22rpx;
  font-weight: 780;
}

.entry-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 130rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 22rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
  transition: transform 150ms ease-out, box-shadow 150ms ease-out, background-color 150ms ease-out;
  animation: cardRise 360ms cubic-bezier(0.2, 0, 0, 1);
}

.entry-card:active {
  transform: scale(0.985);
  box-shadow: 0 6rpx 16rpx rgba(20, 28, 23, 0.04);
}

.entry-card:active .entry-icon {
  transform: translateX(3rpx) scale(0.96);
}

.primary-entry {
  border-color: rgba(16, 23, 20, 0.22);
  background: #101714;
  color: #fffefa;
  box-shadow: 0 14rpx 32rpx rgba(16, 23, 20, 0.12);
}

.primary-entry .entry-icon {
  background: #fffefa;
  color: #101714;
}

.primary-entry .entry-title {
  color: #fffefa;
}

.primary-entry .entry-text,
.primary-entry .entry-arrow {
  color: rgba(255, 254, 250, 0.72);
}

.entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
}

.entry-content {
  flex: 1;
  min-width: 0;
}

.entry-title {
  color: #101714;
  font-size: 31rpx;
  font-weight: 850;
}

.entry-text {
  margin-top: 6rpx;
  color: #69746d;
  font-size: 25rpx;
  line-height: 1.45;
}

.entry-arrow {
  color: #8a928c;
  font-size: 42rpx;
  line-height: 1;
}

@keyframes cardRise {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
