.compact {
  padding-bottom: 18rpx;
}

.feedback-card {
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 26rpx;
  padding: 24rpx;
  background: #fffefa;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #101714;
  color: #fffefa;
  font-size: 23rpx;
  font-weight: 760;
}

.tag.soft {
  background: #e8eee6;
  color: #314036;
}

.feedback-title {
  margin-top: 18rpx;
  color: #101714;
  font-size: 33rpx;
  font-weight: 850;
  line-height: 1.3;
}

.feedback-text {
  margin-top: 12rpx;
  color: #2f3b34;
  font-size: 28rpx;
  line-height: 1.7;
}

.feedback-foot {
  margin-top: 10rpx;
  color: #69746d;
  font-size: 24rpx;
  line-height: 1.5;
}

.loading-more {
  padding: 20rpx 0;
  color: #69746d;
  text-align: center;
  font-size: 25rpx;
}
