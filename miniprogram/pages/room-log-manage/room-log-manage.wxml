<view class="page manage-page">
  <view class="hero compact">
    <view class="eyebrow">有空开门</view>
    <view class="title">今天在客厅，就把门开起来。</view>
    <view class="body">预约开门、确认开门、确认关门和写夜记都会同步到首页。公开文字会先经过安全分析。</view>
  </view>

  <view class="status-strip tone-{{roomStatus.tone}}" bindtap="goPublicLogs">
    <view>
      <view class="strip-label">{{roomStatus.statusLabel}}</view>
      <view class="strip-title">{{roomStatus.title}}</view>
      <view class="strip-text">{{roomStatus.text || "点进值班记录，可以看看今天谁在客厅。"}}</view>
    </view>
    <view class="strip-door"><view></view></view>
  </view>

  <view class="form-card">
    <view class="form-head">
      <view>
        <view class="form-title">{{editingId ? "编辑开门记录" : "预约开门"}}</view>
        <view class="field-hint">{{editingId ? "保存后，会重新审核有变化的公开文字。" : "任何人都可以预约开门，方便朋友知道今天是否有人在。"}}</view>
      </view>
      <view wx:if="{{editingId}}" class="new-link" bindtap="resetForm">新建</view>
    </view>

    <view wx:if="{{message}}" class="message">{{message}}</view>

    <view class="field">
      <view class="field-label">轮值看门人</view>
      <input class="input" value="{{form.keeperName}}" maxlength="40" placeholder="例如：Siry" data-field="keeperName" bindinput="handleInput" />
    </view>

    <view class="field two-columns">
      <view>
        <view class="field-label">计划开门日期</view>
        <picker mode="date" value="{{form.openDate}}" start="{{today}}" data-field="openDate" bindchange="handlePickerChange">
          <view class="select">{{form.openDate}}</view>
        </picker>
      </view>
      <view>
        <view class="field-label">计划开门时间</view>
        <picker mode="time" value="{{form.openTime}}" data-field="openTime" bindchange="handlePickerChange">
          <view class="select">{{form.openTime}}</view>
        </picker>
      </view>
    </view>

    <view class="field two-columns">
      <view>
        <view class="field-label">计划关门日期</view>
        <picker mode="date" value="{{form.closeDate}}" start="{{form.openDate}}" data-field="closeDate" bindchange="handlePickerChange">
          <view class="select">{{form.closeDate}}</view>
        </picker>
      </view>
      <view>
        <view class="field-label">计划关门时间</view>
        <picker mode="time" value="{{form.closeTime}}" data-field="closeTime" bindchange="handlePickerChange">
          <view class="select">{{form.closeTime}}</view>
        </picker>
      </view>
    </view>

    <view class="field">
      <view class="field-label">开门文字</view>
      <view class="rich-toolbar">
        <view class="tool {{!openFormats.header ? 'active' : ''}}" data-field="openNote" data-name="header" data-value="" bindtap="formatRichText">正文</view>
        <view class="tool {{openFormats.header === 1 || openFormats.header === '1' ? 'active' : ''}}" data-field="openNote" data-name="header" bindtap="formatRichText">H1</view>
        <view class="tool {{openFormats.bold ? 'active' : ''}}" data-field="openNote" data-name="bold" bindtap="formatRichText">B</view>
        <view class="tool {{openFormats.italic ? 'active' : ''}}" data-field="openNote" data-name="italic" bindtap="formatRichText">I</view>
        <view class="tool" data-field="openNote" data-name="list" data-value="bullet" bindtap="formatRichText">•</view>
        <view class="tool" data-field="openNote" bindtap="insertDivider">线</view>
        <view class="tool wide muted-tool" data-field="openNote" bindtap="undoRichText">撤销</view>
        <view class="tool wide muted-tool" data-field="openNote" bindtap="clearRichText">清空</view>
      </view>
      <editor
        id="openNoteEditor"
        class="rich-editor"
        style="height: {{openNoteEditorHeight}}rpx;"
        placeholder="可以写今天开门时间、今日轮值、现场有什么可以一起吃/聊/做。"
        data-field="openNote"
        bindready="onEditorReady"
        bindinput="handleRichTextInput"
        bindstatuschange="handleRichTextStatusChange"
      />
      <view wx:if="{{openNotePreview}}" class="rich-preview">
        <view class="field-label">开门文字预览</view>
        <rich-text class="rich-preview-body" nodes="{{openNotePreview}}" />
      </view>
    </view>

    <view class="field">
      <view class="field-label">夜记</view>
      <view class="field-hint">可以先不写，关门时再补。没有夜记时，公开页不会展示这一块。</view>
      <view class="rich-toolbar">
        <view class="tool {{!nightFormats.header ? 'active' : ''}}" data-field="nightNote" data-name="header" data-value="" bindtap="formatRichText">正文</view>
        <view class="tool {{nightFormats.header === 1 || nightFormats.header === '1' ? 'active' : ''}}" data-field="nightNote" data-name="header" bindtap="formatRichText">H1</view>
        <view class="tool {{nightFormats.bold ? 'active' : ''}}" data-field="nightNote" data-name="bold" bindtap="formatRichText">B</view>
        <view class="tool {{nightFormats.italic ? 'active' : ''}}" data-field="nightNote" data-name="italic" bindtap="formatRichText">I</view>
        <view class="tool" data-field="nightNote" data-name="list" data-value="bullet" bindtap="formatRichText">•</view>
        <view class="tool" data-field="nightNote" bindtap="insertDivider">线</view>
        <view class="tool wide muted-tool" data-field="nightNote" bindtap="undoRichText">撤销</view>
        <view class="tool wide muted-tool" data-field="nightNote" bindtap="clearRichText">清空</view>
      </view>
      <editor
        id="nightNoteEditor"
        class="rich-editor night-editor"
        style="height: {{nightNoteEditorHeight}}rpx;"
        placeholder="客厅已关门后，可以写今天发生了什么。"
        data-field="nightNote"
        bindready="onEditorReady"
        bindinput="handleRichTextInput"
        bindstatuschange="handleRichTextStatusChange"
      />
      <view wx:if="{{nightNotePreview}}" class="rich-preview">
        <view class="field-label">夜记预览</view>
        <rich-text class="rich-preview-body" nodes="{{nightNotePreview}}" />
      </view>
    </view>

    <view class="button-stack">
      <view class="button" bindtap="submitRoomLog">{{submitting ? "保存中..." : (editingId ? "保存开门记录" : "预约开门")}}</view>
      <view class="button secondary" bindtap="goPublicLogs">查看值班记录</view>
      <view class="button secondary" bindtap="downloadPoster">{{shareImageLoading ? "生成中..." : "下载开门海报"}}</view>
    </view>
  </view>

  <view class="section-title">我的值班记录</view>
  <view wx:if="{{loading}}" class="panel muted">正在读取我的值班记录...</view>
  <view wx:elif="{{error}}" class="panel muted">{{error}}</view>
  <block wx:elif="{{roomLogs.length}}">
    <view class="mine-card tone-{{item.tone}}" wx:for="{{roomLogs}}" wx:key="id">
      <view class="mine-head">
        <view>
          <view class="mine-date">{{item.dateLabel || "日期待定"}} · {{item.statusLabel}}</view>
          <view class="mine-title">{{item.keeperName || "有空朋友"}}</view>
        </view>
        <view class="mine-pill">{{item.timingText || "时间待定"}}</view>
      </view>
      <view class="mine-status-row">
        <text wx:if="{{item.openNoteInReview}}">开门文字待审核</text>
        <text wx:if="{{item.nightNoteInReview}}">夜记待审核</text>
        <text wx:if="{{item.openNoteRejected}}">开门文字不展示</text>
        <text wx:if="{{item.nightNoteRejected}}">夜记不展示</text>
      </view>
      <view wx:if="{{item.openNote}}" class="mine-note">
        <view class="note-title">开门文字</view>
        <rich-text class="note-content" nodes="{{item.openNote}}" />
      </view>
      <view wx:if="{{item.nightNote}}" class="mine-note">
        <view class="note-title">夜记</view>
        <rich-text class="note-content" nodes="{{item.nightNote}}" />
      </view>
      <view class="card-actions">
        <view class="mini-action" data-id="{{item.id}}" bindtap="editLog">编辑</view>
        <view wx:if="{{item.canOpen}}" class="mini-action primary" data-id="{{item.id}}" bindtap="confirmOpen">确认开门</view>
        <view wx:if="{{item.canClose}}" class="mini-action secondary" data-id="{{item.id}}" bindtap="confirmClose">确认关门</view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="loading-more">继续读取中...</view>
    <view wx:elif="{{!hasMore}}" class="loading-more">已经到底了</view>
  </block>
  <empty-state wx:else title="还没有值班记录" text="如果你今天会在客厅，可以先预约开门。" />

  <canvas canvas-id="shareCanvas" class="share-canvas" style="width: {{shareCanvasWidth}}px; height: {{shareCanvasHeight}}px;"></canvas>
</view>
