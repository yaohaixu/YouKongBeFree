.manage-page {
  padding-bottom: 100rpx;
}

.compact {
  padding-bottom: 22rpx;
}

.status-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 26rpx;
  padding: 24rpx;
  color: #fffefa;
  box-shadow: 0 14rpx 32rpx rgba(20, 28, 23, 0.09);
}

.status-strip:active .strip-door {
  transform: translateY(2rpx) scale(0.96);
}

.status-strip.tone-open {
  background: linear-gradient(145deg, #0f2a1a 0%, #1f6233 100%);
}

.status-strip.tone-upcoming {
  background: linear-gradient(145deg, #49320f 0%, #936e24 100%);
}

.status-strip.tone-closed {
  background: linear-gradient(145deg, #4b1b16 0%, #8d3329 100%);
}

.status-strip.tone-empty {
  background: linear-gradient(145deg, #101714 0%, #203226 100%);
}

.strip-label {
  color: rgba(255, 254, 250, 0.72);
  font-size: 23rpx;
  font-weight: 780;
}

.strip-title {
  margin-top: 8rpx;
  color: #fffefa;
  font-size: 34rpx;
  font-weight: 880;
  line-height: 1.28;
}

.strip-text {
  margin-top: 8rpx;
  color: rgba(255, 254, 250, 0.7);
  font-size: 24rpx;
  line-height: 1.52;
}

.strip-door {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
}

.form-card,
.mine-card {
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 26rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
}

.form-head,
.mine-head,
.card-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.form-title {
  color: #101714;
  font-size: 34rpx;
  font-weight: 860;
}

.new-link {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  background: #e9eee8;
  color: #314036;
  font-size: 24rpx;
  font-weight: 780;
}

.message {
  margin-top: 18rpx;
  border-radius: 20rpx;
  padding: 16rpx 18rpx;
  background: #eef5ef;
  color: #245d3a;
  font-size: 25rpx;
  line-height: 1.55;
}

.field {
  margin-top: 28rpx;
}

.field-label {
  color: #101714;
  font-size: 28rpx;
  font-weight: 780;
}

.field-hint {
  margin-top: 8rpx;
  color: #69746d;
  font-size: 24rpx;
  line-height: 1.55;
}

.input,
.select {
  width: 100%;
  min-height: 88rpx;
  margin-top: 14rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 20rpx;
  padding: 0 24rpx;
  background: #f8f9f6;
  color: #101714;
  font-size: 28rpx;
  line-height: 88rpx;
}

.two-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.rich-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tool {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 18rpx;
  padding: 0 16rpx;
  background: #f8f9f6;
  color: #101714;
  font-size: 25rpx;
  font-weight: 820;
}

.tool.active {
  background: #101714;
  color: #ffffff;
}

.tool.wide {
  min-width: 112rpx;
}

.muted-tool {
  color: #69746d;
}

.rich-editor {
  min-height: 300rpx;
  max-height: 760rpx;
  margin-top: 16rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  background: #f8f9f6;
  color: #101714;
  font-size: 28rpx;
  line-height: 1.68;
  transition: height 180ms cubic-bezier(0.2, 0, 0, 1);
}

.night-editor {
  min-height: 360rpx;
}

.rich-preview {
  overflow: hidden;
  margin-top: 20rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.07);
  border-radius: 22rpx;
  padding: 20rpx;
  background: #ffffff;
}

.rich-preview-body,
.note-content {
  display: block;
  max-width: 100%;
  margin-top: 12rpx;
  color: #24342a;
  font-size: 27rpx;
  line-height: 1.72;
  overflow: hidden;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.button-stack {
  margin-top: 28rpx;
}

.mine-card {
  margin-bottom: 18rpx;
}

.mine-date {
  color: #69746d;
  font-size: 23rpx;
  font-weight: 760;
}

.mine-title {
  margin-top: 8rpx;
  color: #101714;
  font-size: 33rpx;
  font-weight: 850;
}

.mine-pill {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #e9eee8;
  color: #314036;
  font-size: 23rpx;
  font-weight: 780;
}

.mine-status-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.mine-status-row text {
  border-radius: 999rpx;
  padding: 7rpx 14rpx;
  background: #fff2d0;
  color: #765211;
  font-size: 22rpx;
  font-weight: 760;
}

.review-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 14rpx;
  border-radius: 18rpx;
  padding: 13rpx 16rpx;
  background: #fff6e6;
  color: #765211;
  font-size: 23rpx;
  font-weight: 720;
  line-height: 1.5;
}

.review-line text {
  flex: 1;
  min-width: 0;
}

.mine-note {
  margin-top: 18rpx;
  border-top: 1rpx solid rgba(16, 23, 20, 0.08);
  padding-top: 18rpx;
}

.note-title {
  color: #101714;
  font-size: 27rpx;
  font-weight: 830;
}

.card-actions {
  align-items: stretch;
  flex-direction: column;
  margin-top: 20rpx;
}

.mini-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 999rpx;
  background: #fcfcfa;
  color: #101714;
  font-size: 26rpx;
  font-weight: 780;
  white-space: nowrap;
}

.mini-action.primary {
  background: #101714;
  color: #ffffff;
}

.mini-action.secondary {
  background: #e9eee8;
  color: #314036;
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}
