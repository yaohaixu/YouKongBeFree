.room-status-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 30rpx;
  padding: 38rpx 32rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  box-shadow: 0 20rpx 48rpx rgba(16, 23, 20, 0.18);
}

.room-status-card:active .room-orb,
.quick-item:active .quick-icon {
  transform: translateY(2rpx) scale(0.96);
}

.room-status-card.tone-open {
  background: linear-gradient(145deg, #0f2a1a 0%, #164326 58%, #1f6233 100%);
}

.room-status-card.tone-upcoming {
  background: linear-gradient(145deg, #2f2412 0%, #5f4215 56%, #936e24 100%);
}

.room-status-card.tone-closed {
  background: linear-gradient(145deg, #2f1512 0%, #5a211b 56%, #8d3329 100%);
}

.room-status-card.tone-empty {
  background: linear-gradient(145deg, #101714 0%, #17241c 58%, #203226 100%);
}

.room-status-card::after {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(194, 232, 190, 0.6), rgba(255, 255, 255, 0));
  content: "";
}

.home-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.room-status-main {
  display: flex;
  gap: 22rpx;
  margin-top: 30rpx;
}

.room-orb {
  flex: 0 0 auto;
  width: 94rpx;
  height: 94rpx;
  border-radius: 30rpx;
}

.room-copy {
  flex: 1;
  min-width: 0;
}

.room-status-card .title {
  max-width: 520rpx;
  color: #fffefa;
  font-size: 48rpx;
  line-height: 1.08;
}

.room-status-card .body {
  max-width: 560rpx;
  color: rgba(255, 254, 250, 0.76);
}

.room-meta {
  margin-top: 14rpx;
  color: rgba(255, 254, 250, 0.66);
  font-size: 24rpx;
  line-height: 1.5;
}

.home-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  border-radius: 999rpx;
  padding: 9rpx 16rpx;
  background: rgba(255, 254, 250, 0.1);
  color: rgba(255, 254, 250, 0.86);
  font-size: 23rpx;
  font-weight: 760;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #8de39e;
  box-shadow: 0 0 0 8rpx rgba(141, 227, 158, 0.12);
  animation: livePulse 1800ms ease-in-out infinite;
}

.home-chip {
  flex: 0 0 auto;
  border: 1rpx solid rgba(255, 254, 250, 0.12);
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
  color: rgba(255, 254, 250, 0.62);
  font-size: 21rpx;
  font-weight: 760;
}

.home-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 28rpx;
}

.home-actions .button {
  min-width: 0;
  background: #fffefa;
  color: #101714;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.16);
}

.home-actions .button.secondary {
  border-color: rgba(255, 254, 250, 0.16);
  background: rgba(255, 254, 250, 0.08);
  color: #fffefa;
  box-shadow: none;
}

.quick-strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 28rpx;
}

.quick-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid rgba(255, 254, 250, 0.12);
  border-radius: 22rpx;
  padding: 18rpx;
  background: rgba(255, 254, 250, 0.06);
  transition: transform 150ms ease-out, background-color 150ms ease-out;
}

.quick-item:active {
  transform: scale(0.982);
  background: rgba(255, 254, 250, 0.1);
}

.quick-icon {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
}

.quick-item text:first-child {
  display: block;
  color: #fffefa;
  font-size: 26rpx;
  font-weight: 820;
}

.quick-item text:last-child {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 254, 250, 0.58);
  font-size: 22rpx;
  line-height: 1.45;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 0 18rpx;
}

.section-heading .section-title {
  margin: 0;
}

.section-more {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  background: #fcfcfa;
  color: #34443b;
  font-size: 24rpx;
  font-weight: 760;
  box-shadow: 0 8rpx 18rpx rgba(20, 28, 23, 0.045);
}

@keyframes livePulse {
  0%,
  100% {
    opacity: 0.72;
    transform: scale(0.92);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}
