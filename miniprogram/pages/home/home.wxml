<view class="page">
  <view class="room-status-card tone-{{roomStatus.tone}}" bindtap="goRoomLogs">
    <view class="home-hero-top">
      <view class="home-badge">
        <view class="live-dot"></view>
        <text>重庆 · 有空客厅</text>
      </view>
      <view class="home-chip">{{roomStatus.statusLabel}}</view>
    </view>
    <view class="room-status-main">
      <view class="room-orb">
        <view></view>
      </view>
      <view class="room-copy">
        <view class="title">{{roomStatus.title}}</view>
        <view class="body">{{roomStatus.text || "点进值班记录，可以看看今天谁在客厅。"}}</view>
        <view wx:if="{{roomStatus.hasLog}}" class="room-meta">今日轮值：{{roomStatus.currentLog.keeperName || "有空朋友"}} · {{roomStatus.currentLog.timingText || "时间待定"}}</view>
      </view>
    </view>
    <view class="home-actions">
      <view class="button" catchtap="goRoomLogs">看值班记录</view>
      <view class="button secondary" catchtap="goRoomLogManage">预约开门</view>
    </view>
    <view class="quick-strip">
      <view class="quick-item" bindtap="goActivities">
        <view class="quick-icon yk-icon yk-icon-calendar">
          <view class="icon-calendar-body"></view>
          <view class="icon-calendar-top"></view>
          <view class="icon-calendar-dot"></view>
        </view>
        <view>
          <text>近期</text>
          <text>正在发生的活动</text>
        </view>
      </view>
      <view class="quick-item" bindtap="goEditor">
        <view class="quick-icon yk-icon yk-icon-compose">
          <view class="icon-sheet"></view>
          <view class="icon-pen"></view>
        </view>
        <view>
          <text>发起</text>
          <text>写下一个活动想法</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-heading">
    <view class="section-title">近期活动</view>
    <view class="section-more" bindtap="goActivities">全部</view>
  </view>
  <view wx:if="{{loading}}" class="panel muted">正在读取活动...</view>
  <view wx:elif="{{error}}" class="panel muted">{{error}}</view>
  <view wx:elif="{{activities.length}}" class="list">
    <activity-card wx:for="{{activities}}" wx:key="id" activity="{{item}}" bind:register="openActivityDetail" bind:interest="recordInterest" bind:reminder="subscribeReminder" />
  </view>
  <empty-state wx:else title="近期还没有公开活动" text="等第一位朋友把活动发出来，这里就会亮起来。" />
</view>
