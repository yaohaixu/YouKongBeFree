.room-page {
  padding-bottom: 90rpx;
}

.room-status-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  padding: 32rpx;
  color: #fffefa;
  box-shadow: 0 20rpx 48rpx rgba(16, 23, 20, 0.16);
}

.room-status-card.tone-open {
  background: linear-gradient(145deg, #0f2a1a 0%, #164326 58%, #1f6233 100%);
}

.room-status-card.tone-upcoming {
  background: linear-gradient(145deg, #2f2412 0%, #5f4215 56%, #936e24 100%);
}

.room-status-card.tone-closed {
  background: linear-gradient(145deg, #2f1512 0%, #5a211b 56%, #8d3329 100%);
}

.room-status-card.tone-empty {
  background: linear-gradient(145deg, #101714 0%, #17241c 58%, #203226 100%);
}

.status-top,
.status-main,
.status-actions,
.log-head {
  display: flex;
  align-items: center;
}

.status-top,
.log-head {
  justify-content: space-between;
  gap: 18rpx;
}

.status-badge,
.status-date {
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 254, 250, 0.12);
  color: rgba(255, 254, 250, 0.84);
  font-size: 23rpx;
  font-weight: 780;
}

.status-main {
  align-items: flex-start;
  gap: 22rpx;
  margin-top: 30rpx;
}

.status-orb {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 94rpx;
  height: 94rpx;
  border: 1rpx solid rgba(255, 254, 250, 0.14);
  border-radius: 30rpx;
  background: rgba(255, 254, 250, 0.1);
}

.status-orb view {
  width: 34rpx;
  height: 44rpx;
  border: 5rpx solid currentColor;
  border-radius: 12rpx 12rpx 7rpx 7rpx;
  color: rgba(255, 254, 250, 0.88);
  transform: perspective(80rpx) rotateY(-16deg);
}

.status-copy {
  flex: 1;
  min-width: 0;
}

.status-title {
  color: #fffefa;
  font-size: 48rpx;
  font-weight: 880;
  line-height: 1.12;
}

.status-text,
.status-meta {
  margin-top: 14rpx;
  color: rgba(255, 254, 250, 0.76);
  font-size: 26rpx;
  line-height: 1.62;
}

.status-meta {
  color: rgba(255, 254, 250, 0.62);
  font-size: 24rpx;
}

.status-actions {
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
  margin-top: 28rpx;
}

.status-actions .button {
  width: 100%;
  background: #fffefa;
  color: #101714;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.13);
}

.status-actions .button.secondary {
  border-color: rgba(255, 254, 250, 0.18);
  background: rgba(255, 254, 250, 0.08);
  color: #fffefa;
  box-shadow: none;
}

.share-button {
  border: 0;
  margin: 0;
}

.share-button::after {
  border: 0;
}

.section-heading {
  margin: 38rpx 0 18rpx;
}

.section-heading .section-title {
  margin: 0;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #69746d;
  font-size: 25rpx;
  line-height: 1.55;
}

.room-log-card {
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 24rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
}

.room-log-card.highlighted {
  border-color: rgba(49, 98, 75, 0.36);
  box-shadow: 0 12rpx 28rpx rgba(49, 98, 75, 0.12);
}

.log-date {
  color: #69746d;
  font-size: 23rpx;
  font-weight: 760;
}

.log-title {
  margin-top: 8rpx;
  color: #101714;
  font-size: 34rpx;
  font-weight: 860;
  line-height: 1.3;
}

.log-pill {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #e9eee8;
  color: #314036;
  font-size: 23rpx;
  font-weight: 780;
}

.tone-open .log-pill {
  background: #e6f2e8;
  color: #1f6537;
}

.tone-upcoming .log-pill {
  background: #fff2d0;
  color: #765211;
}

.tone-closed .log-pill {
  background: #fff0eb;
  color: #9f392b;
}

.log-meta,
.log-empty {
  margin-top: 14rpx;
  color: #69746d;
  font-size: 25rpx;
  line-height: 1.55;
}

.note-block {
  margin-top: 18rpx;
  border-top: 1rpx solid rgba(16, 23, 20, 0.08);
  padding-top: 18rpx;
}

.note-title {
  color: #101714;
  font-size: 27rpx;
  font-weight: 830;
}

.note-content {
  display: block;
  margin-top: 12rpx;
  color: #2f3b34;
  font-size: 28rpx;
  line-height: 1.78;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}
