.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 38rpx 28rpx;
  background: #fcfcfa;
  box-shadow: 0 14rpx 34rpx rgba(20, 28, 23, 0.055);
}

.avatar {
  width: 152rpx;
  height: 152rpx;
  border-radius: 44rpx;
  background: linear-gradient(145deg, #eef5ef, #dfe8dc);
  box-shadow: 0 12rpx 28rpx rgba(20, 28, 23, 0.08);
}

.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #101714;
  font-size: 56rpx;
  font-weight: 880;
}

.profile-name {
  margin-top: 22rpx;
  color: #101714;
  font-size: 42rpx;
  font-weight: 880;
}

.profile-id {
  margin-top: 8rpx;
  color: #69746d;
  font-size: 24rpx;
}

.profile-bio {
  margin-top: 18rpx;
  color: #4d5b53;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.65;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-top: 20rpx;
}

.badge {
  border: 1rpx solid rgba(16, 23, 20, 0.06);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #101714;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 760;
}

.badge.soft {
  background: #e9eee8;
  color: #314036;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.stat {
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 22rpx;
  padding: 20rpx 8rpx;
  background: #fcfcfa;
  color: #69746d;
  text-align: center;
  font-size: 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(20, 28, 23, 0.04);
}

.num {
  display: block;
  margin-bottom: 6rpx;
  color: #101714;
  font-size: 34rpx;
  font-weight: 880;
}
