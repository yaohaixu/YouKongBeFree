.success-hero {
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 24rpx;
  padding: 34rpx 28rpx;
  background: #fffefa;
}

.success-hero.is-cancelled {
  background: #fff7f2;
}

.success-mark {
  display: inline-flex;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  background: #101714;
  color: #fffefa;
  font-size: 24rpx;
  font-weight: 820;
}

.success-hero.is-cancelled .success-mark {
  background: #9f392b;
}

.info-card {
  margin-top: 22rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 24rpx;
  padding: 26rpx;
  background: #fffefa;
}

.info-title {
  color: #101714;
  font-size: 34rpx;
  font-weight: 860;
  line-height: 1.32;
}

.info-line {
  margin-top: 12rpx;
  color: #34443b;
  font-size: 27rpx;
  line-height: 1.55;
}

.muted-line {
  color: #69746d;
  font-size: 24rpx;
}

.danger-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  border: 1rpx solid rgba(159, 57, 43, 0.18);
  border-radius: 26rpx;
  padding: 22rpx;
  background: #fff7f2;
}

.danger-title {
  color: #101714;
  font-size: 27rpx;
  font-weight: 820;
}

.danger-body {
  margin-top: 6rpx;
  color: #7c5148;
  font-size: 24rpx;
  line-height: 1.5;
}

.danger-action {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 14rpx 20rpx;
  background: #fff1ec;
  color: #9f392b;
  font-size: 25rpx;
  font-weight: 800;
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}

@media (max-width: 420px) {
  .danger-card {
    align-items: flex-start;
    flex-direction: column;
  }
}
