.success-hero {
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  background: #fcfcfa;
  box-shadow: 0 14rpx 34rpx rgba(20, 28, 23, 0.055);
}

.success-hero.is-cancelled {
  background: #fff7f2;
}

.success-mark {
  display: inline-flex;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  background: #101714;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 820;
}

.success-hero.is-cancelled .success-mark {
  background: #9f392b;
}

.info-card {
  margin-top: 22rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 26rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
}

.info-title {
  color: #101714;
  font-size: 34rpx;
  font-weight: 860;
  line-height: 1.32;
}

.info-line {
  margin-top: 12rpx;
  color: #34443b;
  font-size: 27rpx;
  line-height: 1.55;
}

.muted-line {
  color: #69746d;
  font-size: 24rpx;
}

.danger-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  border: 1rpx solid rgba(159, 57, 43, 0.18);
  border-radius: 24rpx;
  padding: 22rpx;
  background: #fff7f2;
}

.danger-title {
  color: #101714;
  font-size: 27rpx;
  font-weight: 820;
}

.danger-body {
  margin-top: 6rpx;
  color: #7c5148;
  font-size: 24rpx;
  line-height: 1.5;
}

.danger-action {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 14rpx 20rpx;
  background: #fff1ec;
  color: #9f392b;
  font-size: 25rpx;
  font-weight: 800;
}

.share-button {
  border: 0;
  margin: 0;
}

.share-button::after {
  border: 0;
}

.button.feeling {
  border-color: rgba(157, 73, 42, 0.18);
  background: #a24d2b;
  color: #ffffff;
}

.feeling-note {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  border-radius: 999rpx;
  background: #f1ece4;
  color: #7a5f4f;
  font-size: 25rpx;
  font-weight: 760;
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}

@media (max-width: 420px) {
  .danger-card {
    align-items: flex-start;
    flex-direction: column;
  }
}
