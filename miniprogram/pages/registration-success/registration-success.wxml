<view class="page">
  <view wx:if="{{loading}}" class="panel muted">正在读取报名结果...</view>
  <view wx:elif="{{error}}" class="panel muted">{{error}}</view>
  <view wx:else>
    <view class="success-hero {{cancelled ? 'is-cancelled' : ''}}">
      <view class="success-mark">{{cancelled ? "已取消" : "已报名"}}</view>
      <view class="title">{{cancelled ? "这次报名已经取消。" : "你的报名已经记录下来。"}}</view>
      <view class="body">{{cancelled ? "如果之后还想参加，可以回到活动页重新报名。" : "活动开始前，可以从这里回看报名信息、保存邀请函或取消报名。"}}</view>
    </view>

    <view class="info-card">
      <view class="info-title">{{activity.title || "有空活动"}}</view>
      <view class="info-line">昵称：{{registration.nickname || "有空朋友"}}</view>
      <view class="info-line">地点：{{activity.location || "地点待定"}}</view>
      <view class="info-line">时间：{{activity.displayTime || "时间待定"}}</view>
      <view wx:if="{{activity.displayFormation}}" class="info-line muted-line">{{activity.displayFormation}}</view>
    </view>

    <view class="button-stack">
      <view class="button" bindtap="openActivity"><yk-icon name="activity" size="{{28}}" tone="light" custom-class="button-icon" />查看活动</view>
      <view class="button secondary" bindtap="goMyRegistrations"><yk-icon name="ticket" size="{{28}}" custom-class="button-icon" />查看我的报名</view>
      <view class="button secondary" bindtap="downloadInvitationPoster"><yk-icon name="poster" size="{{28}}" custom-class="button-icon" />{{shareImageLoading ? "生成中..." : "下载活动邀请函"}}</view>
      <button class="button secondary share-button" open-type="share"><yk-icon name="share" size="{{28}}" custom-class="button-icon" />分享小程序链接</button>
      <view class="button secondary" bindtap="addToCalendar"><yk-icon name="calendar" size="{{28}}" custom-class="button-icon" />加到日历</view>
      <view wx:if="{{activity.canWriteFeedback && !activity.hasMyFeedback && !cancelled}}" class="button feeling" bindtap="goFeedback"><yk-icon name="feedback" size="{{28}}" tone="light" custom-class="button-icon" />写下活动感受</view>
      <view wx:elif="{{activity.hasMyFeedback && !cancelled}}" class="feeling-note">已写活动感受</view>
    </view>

    <view wx:if="{{!cancelled}}" class="danger-card">
      <view>
        <view class="danger-title">不能来了？</view>
        <view class="danger-body">取消后会释放名额，需要参加时可以重新报名。</view>
      </view>
      <view class="danger-action" bindtap="cancelRegistration"><yk-icon name="x" size="{{24}}" custom-class="mini-icon" />{{cancelling ? "取消中..." : "取消报名"}}</view>
    </view>
  </view>
  <canvas canvas-id="shareCanvas" class="share-canvas" style="width: {{shareCanvasWidth}}px; height: {{shareCanvasHeight}}px;"></canvas>
</view>
