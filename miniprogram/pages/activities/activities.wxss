.compact {
  padding-bottom: 18rpx;
}

.tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin: 10rpx 0 28rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 22rpx;
  background: #fcfcfa;
  box-shadow: 0 8rpx 20rpx rgba(20, 28, 23, 0.04);
}

.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: 16rpx;
  color: #65706a;
  font-size: 27rpx;
  font-weight: 760;
  transition: transform 150ms ease-out, background-color 150ms ease-out;
}

.tab:active,
.source-tab:active,
.series-tab:active {
  transform: scale(0.98);
}

.tab.active {
  background: #101714;
  color: #ffffff;
}

.source-tabs,
.series-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: -8rpx 0 28rpx;
}

.series-tabs {
  margin-top: -16rpx;
}

.source-tab,
.series-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 16rpx;
  padding: 0 24rpx;
  background: #fcfcfa;
  color: #59665e;
  font-size: 25rpx;
  font-weight: 760;
  box-shadow: 0 6rpx 16rpx rgba(20, 28, 23, 0.035);
}

.source-tab.active,
.series-tab.active {
  border-color: rgba(16, 23, 20, 0.18);
  background: #e9eee8;
  color: #101714;
}

.series-tab {
  background: #f8f9f6;
}

.loading-more {
  padding: 18rpx 0;
  color: #69746d;
  text-align: center;
  font-size: 25rpx;
}
