.compact {
  padding-bottom: 16rpx;
}

.tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin: 10rpx 0 28rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 22rpx;
  background: #fffefa;
}

.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: 16rpx;
  color: #5f6b64;
  font-size: 27rpx;
  font-weight: 760;
}

.tab.active {
  background: #101714;
  color: #fffefa;
}

.source-tabs,
.series-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: -8rpx 0 28rpx;
}

.series-tabs {
  margin-top: -16rpx;
}

.source-tab,
.series-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 16rpx;
  padding: 0 24rpx;
  background: #fffefa;
  color: #59665e;
  font-size: 25rpx;
  font-weight: 760;
}

.source-tab.active,
.series-tab.active {
  border-color: rgba(16, 23, 20, 0.18);
  background: #edf0ea;
  color: #101714;
}

.series-tab {
  background: #f9f7f1;
}

.loading-more {
  padding: 18rpx 0;
  color: #69746d;
  text-align: center;
  font-size: 25rpx;
}
