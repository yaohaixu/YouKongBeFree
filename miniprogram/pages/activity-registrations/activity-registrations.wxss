.compact {
  padding-bottom: 16rpx;
}

.summary-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 26rpx;
  background: #fcfcfa;
  color: #69746d;
  font-size: 26rpx;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
}

.summary-card > view:first-child {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.summary-num {
  color: #101714;
  font-size: 48rpx;
  font-weight: 880;
}

.summary-detail {
  max-width: 360rpx;
  color: #69746d;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: right;
}

.formation-card {
  margin-top: 18rpx;
  border-radius: 22rpx;
  padding: 18rpx 20rpx;
  background: #f3f5f0;
  color: #4d5b53;
  font-size: 25rpx;
  line-height: 1.55;
}

.registration-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.registration-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  padding: 22rpx;
  background: #fcfcfa;
  box-shadow: 0 8rpx 20rpx rgba(20, 28, 23, 0.035);
}

.nickname {
  color: #101714;
  font-size: 31rpx;
  font-weight: 840;
}

.time {
  margin-top: 8rpx;
  color: #69746d;
  font-size: 24rpx;
}

.delete-action {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  background: #fff1ec;
  color: #9f392b;
  font-size: 24rpx;
  font-weight: 760;
}

@media (max-width: 420px) {
  .summary-card {
    flex-direction: column;
  }

  .summary-detail {
    max-width: none;
    text-align: left;
  }
}
