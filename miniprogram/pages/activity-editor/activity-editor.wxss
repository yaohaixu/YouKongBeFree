.editor-page {
  padding-bottom: 148rpx;
}

.editor-form {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.form-card {
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 24rpx;
  padding: 28rpx;
  background: #fffefa;
}

.field {
  margin-top: 28rpx;
}

.field:first-child {
  margin-top: 0;
}

.field-label {
  color: #101714;
  font-size: 28rpx;
  font-weight: 780;
}

.field-hint {
  margin-top: 8rpx;
  color: #69746d;
  font-size: 24rpx;
  line-height: 1.55;
}

.input,
.select,
.textarea {
  width: 100%;
  margin-top: 14rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 20rpx;
  background: #f8f5ee;
  color: #101714;
  font-size: 28rpx;
}

.input,
.select {
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.textarea {
  min-height: 280rpx;
  padding: 22rpx 24rpx;
  line-height: 1.68;
}

.lock-card {
  border-color: rgba(159, 57, 43, 0.24);
  background: #fff7f2;
}

.rich-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tool {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 18rpx;
  padding: 0 16rpx;
  background: #f8f5ee;
  color: #101714;
  font-size: 25rpx;
  font-weight: 820;
}

.tool.active {
  background: #101714;
  color: #fffefa;
}

.tool.wide {
  min-width: 112rpx;
}

.muted-tool {
  color: #69746d;
}

.rich-editor {
  min-height: 360rpx;
  margin-top: 16rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  background: #f8f5ee;
  color: #101714;
  font-size: 28rpx;
  line-height: 1.68;
}

.rich-preview {
  margin-top: 22rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 22rpx;
  padding: 20rpx;
  background: #fffefa;
}

.rich-preview-body {
  display: block;
  margin-top: 14rpx;
  color: #24342a;
  font-size: 27rpx;
  line-height: 1.72;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.rich-preview-body image,
.rich-preview-body img {
  max-width: 100%;
  border-radius: 18rpx;
}

.two-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 26rpx;
}

.switch-row:first-child {
  margin-top: 0;
}

.cover-picker,
.cover-preview {
  margin-top: 14rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.cover-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 260rpx;
  border: 1rpx dashed rgba(16, 23, 20, 0.24);
  background: #f8f5ee;
  color: #49544d;
  font-size: 28rpx;
  font-weight: 760;
}

.cover-preview {
  position: relative;
  height: 300rpx;
  background: #ede9df;
}

.cover-preview image {
  width: 100%;
  height: 100%;
}

.cover-remove {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  background: rgba(16, 23, 20, 0.78);
  color: #fffefa;
  font-size: 24rpx;
  font-weight: 760;
}

.invite-box {
  margin-top: 18rpx;
  border-radius: 22rpx;
  padding: 20rpx;
  background: #f2efe7;
}

.invite-title {
  color: #101714;
  font-size: 27rpx;
  font-weight: 820;
}

.invite-url {
  margin-top: 10rpx;
  color: #5e6962;
  font-size: 23rpx;
  line-height: 1.55;
  word-break: break-all;
}

.share-button {
  border: 0;
  margin: 0;
}

.share-button::after {
  border: 0;
}

.button.disabled {
  opacity: 0.48;
}

.sticky-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(16, 23, 20, 0.08);
  background: rgba(255, 254, 250, 0.96);
}
