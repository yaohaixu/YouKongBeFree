.empty-state {
  border: 1rpx dashed rgba(16, 23, 20, 0.16);
  border-radius: 24rpx;
  padding: 42rpx 30rpx;
  background: rgba(252, 252, 250, 0.78);
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(20, 28, 23, 0.035);
}

.title {
  color: #101714;
  font-size: 30rpx;
  font-weight: 820;
}

.text {
  margin-top: 12rpx;
  color: #69746d;
  font-size: 26rpx;
  line-height: 1.6;
}
