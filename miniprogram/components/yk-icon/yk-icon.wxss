:host {
  display: inline-flex;
  flex: 0 0 auto;
  line-height: 0;
  vertical-align: middle;
}

.yk-icon {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  overflow: hidden;
  transition: transform 150ms cubic-bezier(0.2, 0, 0, 1), background-color 150ms ease-out, opacity 150ms ease-out;
}

.yk-icon:active {
  transform: scale(0.94);
}

.yk-icon-image {
  display: block;
  width: 58%;
  height: 58%;
}

.frame-none .yk-icon-image {
  width: 100%;
  height: 100%;
}

.frame-entry,
.frame-identity {
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 22rpx;
  background: #eef3ed;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.frame-quick {
  border: 1rpx solid rgba(255, 254, 250, 0.12);
  border-radius: 18rpx;
  background: rgba(255, 254, 250, 0.16);
}

.frame-entry.tone-primary {
  background: #fffefa;
}

.frame-entry.tone-green,
.frame-identity.tone-green {
  background: #e9f2eb;
}

.frame-entry.tone-blue,
.frame-identity.tone-blue {
  background: #e9f0f3;
}

.frame-entry.tone-amber,
.frame-identity.tone-amber {
  background: #f5eedf;
}

.frame-entry.tone-rose,
.frame-identity.tone-rose {
  background: #f3e9e7;
}

.frame-entry.tone-neutral,
.frame-identity.tone-neutral {
  background: #edf0ec;
}
