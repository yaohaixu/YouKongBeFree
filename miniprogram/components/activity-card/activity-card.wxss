.activity-card {
  overflow: hidden;
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 24rpx;
  background: #fffefa;
}

.cover-wrap {
  padding: 14rpx 14rpx 0;
}

.cover {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 236rpx;
  border-radius: 18rpx;
  background: #dfe8dc;
  color: #2c3831;
  font-size: 30rpx;
  font-weight: 820;
}

.placeholder {
  padding: 0 28rpx;
}

.content {
  position: relative;
  padding: 22rpx 24rpx 24rpx;
}

.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.meta {
  min-width: 0;
  color: #6c5047;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-pill {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 7rpx 14rpx;
  background: #edf0ea;
  color: #34443b;
  font-size: 22rpx;
  font-weight: 760;
}

.series-pill {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  margin-top: 14rpx;
  border: 1rpx solid rgba(79, 111, 88, 0.18);
  border-radius: 999rpx;
  padding: 7rpx 14rpx;
  background: #eef3ed;
  color: #36513d;
  font-size: 23rpx;
  font-weight: 760;
}

.name {
  margin-top: 14rpx;
  color: #101714;
  font-size: 33rpx;
  font-weight: 850;
  line-height: 1.32;
}

.time {
  margin-top: 9rpx;
  color: #4e5b54;
  font-size: 25rpx;
  line-height: 1.45;
}

.summary {
  margin-top: 12rpx;
  color: #59665e;
  font-size: 26rpx;
  line-height: 1.58;
}

.formation-chip {
  margin-top: 14rpx;
  border-radius: 18rpx;
  padding: 12rpx 16rpx;
  background: #f7f2e8;
  color: #4d5b53;
  font-size: 23rpx;
  line-height: 1.5;
}

.foot {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
  color: #4d5b53;
  font-size: 24rpx;
}

.share-mini {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  margin: 20rpx 0 0;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 999rpx;
  padding: 0 24rpx;
  background: #fffefa;
  color: #101714;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 58rpx;
}

.share-mini::after {
  border: 0;
}
