.activity-card {
  overflow: hidden;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 24rpx;
  background: #fcfcfa;
  box-shadow: 0 12rpx 30rpx rgba(20, 28, 23, 0.055);
  transition: transform 160ms ease-out, box-shadow 160ms ease-out;
}

.activity-card:active {
  transform: scale(0.99);
  box-shadow: 0 8rpx 20rpx rgba(20, 28, 23, 0.05);
}

.cover-wrap {
  padding: 14rpx 14rpx 0;
}

.cover {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 238rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #dfe8dc 0%, #f3f6f0 100%);
  color: #22312a;
  font-size: 30rpx;
  font-weight: 820;
}

.placeholder {
  padding: 0 28rpx;
}

.content {
  position: relative;
  padding: 24rpx 24rpx 24rpx;
}

.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.meta {
  min-width: 0;
  color: #31624b;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-pill {
  flex: 0 0 auto;
  border: 1rpx solid rgba(16, 23, 20, 0.06);
  border-radius: 999rpx;
  padding: 7rpx 14rpx;
  background: #eef2ec;
  color: #34443b;
  font-size: 22rpx;
  font-weight: 760;
}

.series-pill {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  margin-top: 14rpx;
  border: 1rpx solid rgba(79, 111, 88, 0.18);
  border-radius: 999rpx;
  padding: 7rpx 14rpx;
  background: #eef4ed;
  color: #36513d;
  font-size: 23rpx;
  font-weight: 760;
}

.name {
  margin-top: 14rpx;
  color: #101714;
  font-size: 34rpx;
  font-weight: 860;
  letter-spacing: 0;
  line-height: 1.32;
}

.time {
  margin-top: 9rpx;
  color: #4c5852;
  font-size: 25rpx;
  line-height: 1.45;
}

.summary {
  margin-top: 12rpx;
  color: #5a665f;
  font-size: 26rpx;
  line-height: 1.58;
}

.formation-chip {
  margin-top: 14rpx;
  border-radius: 18rpx;
  padding: 12rpx 16rpx;
  background: #f3f5f0;
  color: #4d5b53;
  font-size: 23rpx;
  line-height: 1.5;
}

.foot {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
  color: #4d5b53;
  font-size: 24rpx;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 20rpx;
}

.secondary-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.12);
  border-radius: 999rpx;
  padding: 0 18rpx;
  background: #fcfcfa;
  color: #101714;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  transition: opacity 150ms ease-out, transform 150ms ease-out, background-color 150ms ease-out;
}

.action-button:active {
  transform: scale(0.98);
  opacity: 0.88;
}

.action-button.primary {
  min-height: 72rpx;
  background: #101714;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(16, 23, 20, 0.13);
}

.action-button:disabled {
  background: #dfe4dd;
  color: #7c8780;
}
