page {
  min-height: 100vh;
  background: #f5f3ee;
  color: #101714;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 30rpx 28rpx 64rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 30rpx;
  padding: 34rpx 30rpx;
  background: #fffefa;
}

.eyebrow {
  color: #6c5047;
  font-size: 24rpx;
  font-weight: 760;
}

.title {
  margin-top: 14rpx;
  color: #101714;
  font-size: 44rpx;
  font-weight: 850;
  line-height: 1.2;
}

.body {
  margin-top: 16rpx;
  color: #4e5b54;
  font-size: 28rpx;
  line-height: 1.68;
}

.section-title {
  margin: 36rpx 0 18rpx;
  color: #101714;
  font-size: 34rpx;
  font-weight: 820;
}

.panel {
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 24rpx;
  padding: 28rpx;
  background: #fffefa;
}

.muted {
  color: #5f6b64;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 999rpx;
  padding: 0 28rpx;
  background: #101714;
  color: #fffefa;
  font-size: 28rpx;
  font-weight: 760;
  transition: opacity 160ms ease-out, transform 160ms ease-out;
}

.button-row .button {
  flex: 1;
  min-width: 190rpx;
}

.button.secondary {
  border: 1rpx solid rgba(16, 23, 20, 0.14);
  background: #fffefa;
  color: #101714;
}

.button.disabled {
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  background: #dfe4dd;
  color: #7c8780;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.surface-card {
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 24rpx;
  padding: 26rpx;
  background: #fffefa;
}

.soft-card {
  border-radius: 22rpx;
  padding: 22rpx;
  background: #ecefe8;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #edf0ea;
  color: #34443b;
  font-size: 23rpx;
  font-weight: 760;
}
