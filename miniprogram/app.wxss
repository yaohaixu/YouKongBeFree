page {
  min-height: 100vh;
  background: #f4f5f2;
  color: #101714;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 72rpx;
  animation: ykPageIn 360ms cubic-bezier(0.2, 0, 0, 1);
}

.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  background: #fcfcfa;
  box-shadow: 0 14rpx 34rpx rgba(20, 28, 23, 0.06);
}

.eyebrow {
  color: #31624b;
  font-size: 24rpx;
  font-weight: 760;
}

.title {
  margin-top: 14rpx;
  color: #101714;
  font-size: 44rpx;
  font-weight: 860;
  letter-spacing: 0;
  line-height: 1.18;
}

.body {
  margin-top: 16rpx;
  color: #4c5852;
  font-size: 28rpx;
  line-height: 1.68;
}

.section-title {
  margin: 38rpx 0 18rpx;
  color: #101714;
  font-size: 34rpx;
  font-weight: 840;
}

.panel {
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 24rpx;
  padding: 28rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
}

.muted {
  color: #65706a;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.button-stack {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  padding: 0 28rpx;
  background: #101714;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 760;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  box-shadow: 0 10rpx 22rpx rgba(16, 23, 20, 0.14);
  transition: opacity 150ms ease-out, transform 150ms ease-out, background-color 150ms ease-out;
}

.button-icon {
  flex: 0 0 auto;
  margin-right: 10rpx;
}

.button .button-icon {
  color: currentColor;
}

.mini-icon {
  flex: 0 0 auto;
  margin-right: 8rpx;
  color: currentColor;
}

.button::after {
  border: 0;
}

.button-row .button {
  flex: 1;
  min-width: 190rpx;
}

.button-stack .button {
  width: 100%;
  min-width: 0;
}

.button.secondary {
  border: 1rpx solid rgba(16, 23, 20, 0.14);
  background: #fcfcfa;
  color: #101714;
  box-shadow: none;
}

.button.disabled {
  border: 1rpx solid rgba(16, 23, 20, 0.08);
  background: #e4e7e2;
  color: #7c8780;
  box-shadow: none;
}

.button:active {
  transform: scale(0.982);
  opacity: 0.9;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.surface-card {
  border: 1rpx solid rgba(16, 23, 20, 0.1);
  border-radius: 24rpx;
  padding: 26rpx;
  background: #fcfcfa;
  box-shadow: 0 10rpx 26rpx rgba(20, 28, 23, 0.045);
}

.soft-card {
  border-radius: 22rpx;
  padding: 22rpx;
  background: #eef1ec;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #e9eee8;
  color: #30433a;
  font-size: 23rpx;
  font-weight: 760;
}

.loading-more {
  padding: 22rpx 0;
  color: #65706a;
  text-align: center;
  font-size: 25rpx;
}

@keyframes ykPageIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
